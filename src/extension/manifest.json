{
  "manifest_version": 3,
  "name": "Stepcast – interactive demo recorder",
  "short_name": "Stepcast",
  "version": "0.1.0",
  "description": "Record clicks in any web app and turn them into an interactive demo. Open source, everything stays on your computer.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Stepcast",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "minimum_chrome_version": "116"
}
